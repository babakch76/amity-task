<?xml version="1.0" encoding="utf-8"?>
<!--
    Amity Task's mark: four chevrons turning round a square, the turns going
    round a household. Drawn from amity-task-icon-dark.svg; its deep purple
    square is the background layer (ic_launcher_background), not drawn here.

    Adaptive icons use a 108x108dp viewport, and a launcher shows only about the
    middle 72dp of it. The SVG fills its whole square, so everything is drawn at
    two thirds round the centre: what shows is then the SVG as designed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The SVG is drawn edge to edge on 108; a launcher shows only the middle 72. -->
    <group android:scaleX="0.6667" android:scaleY="0.6667" android:pivotX="54" android:pivotY="54">

    <path
        android:pathData="M44,40 L60,26 L76,40"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <group android:rotation="90" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M44,40 L60,26 L76,40"
            android:strokeColor="#FFC4B5FD"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <group android:rotation="180" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M44,40 L60,26 L76,40"
            android:strokeColor="#FFA78BFA"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <group android:rotation="270" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M44,40 L60,26 L76,40"
            android:strokeColor="#FF8B5CF6"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <!-- The square in the middle: 15 by 17 at (46.5, 45.5), corners 4.5. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,45.5 H57 A4.5,4.5 0 0 1 61.5,50 V58 A4.5,4.5 0 0 1 57,62.5 H51 A4.5,4.5 0 0 1 46.5,58 V50 A4.5,4.5 0 0 1 51,45.5 Z" />
    </group>
</vector>
